config { type: "table", bigquery: { partitionBy: "d_year" } }

select c_city, s_city, d_year, sum(lo_revenue) as measure
from ${ref("fact_sales")}
where c_city in ('UNITED KI1', 'UNITED KI5') and s_city in ('UNITED KI1', 'UNITED KI5') and d_year between 1992 and 1997
group by c_city, s_city, d_year
